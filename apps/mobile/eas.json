{
  "cli": { "version": ">= 16.17.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_GALAXY_BILLING_MODE": "TEST" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_GALAXY_BILLING_MODE": "TEST" }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_GALAXY_BILLING_MODE": "PRODUCTION" }
    }
  }
}

