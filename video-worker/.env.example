# Only server-side values. Never add these to apps/mobile/.env.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_KEY
SIMI_VIDEO_DIR=/data/videos
# Optional local neural offline voice. Mount both .onnx and .onnx.json.
SIMI_PIPER_MODEL=/voices/en_US-kristin-medium.onnx
