# Public mobile configuration. Never place service-role or Groq secrets here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=YOUR_REVENUECAT_PUBLIC_ANDROID_KEY
EXPO_PUBLIC_ONESIGNAL_APP_ID=
EXPO_PUBLIC_ONESIGNAL_MODE=development

# Set only for local development when the Edge Function is unavailable.
EXPO_PUBLIC_USE_FIXTURES=false

# Supabase Edge Function secrets (set with `supabase secrets set`, not in Expo).
GROQ_API_KEYS=key_from_org_one,key_from_org_two
GROQ_MODEL=openai/gpt-oss-120b
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH_TOKEN=

